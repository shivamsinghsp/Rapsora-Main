# Copy to .env.local and fill in values (never commit .env or .env.local)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
MONGODB_URI=

# Optional — only if you re-enable NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — email
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# Optional — Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
